# Relief Website Environment Variables
# Copy this file to .env.local and fill in the values

# Resend Email API (add after security review)
# VITE_RESEND_API_KEY=your_resend_api_key_here

# Supabase Configuration (optional, add after security review)
# VITE_SUPABASE_URL=your_supabase_url
# VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Email Addresses (configuration only, no secrets)
VITE_EMAIL_INFO=info@relief-domain.co.uk
VITE_EMAIL_SUPPORT=support@relief-domain.co.uk
VITE_EMAIL_PRIVACY=privacy@relief-domain.co.uk
VITE_EMAIL_HELLO=hello@relief-domain.co.uk

# Analytics (add after security review)
# VITE_ANALYTICS_ID=your_analytics_id

# Site Configuration
VITE_SITE_NAME=Relief
VITE_SITE_URL=https://relief-domain.co.uk
VITE_SITE_DESCRIPTION=Find Comfort, Feel Relief - Discover clean, private and accessible facilities nearby

