# Relief Website Environment Variables
# Copy this file to .env.local and fill in the values.
# NO secrets are required to run the site locally.

# Site Configuration (optional; the app has sensible defaults)
VITE_SITE_NAME=Relief
# VITE_SITE_URL=https://findrelief.co.uk
# VITE_SITE_DESCRIPTION=Find clean, private and accessible facilities nearby

# Analytics (add later, after review)
# VITE_ANALYTICS_ID=your_analytics_id

# Supabase (optional, used on the backend/Cloudflare Worker side)
# VITE_SUPABASE_URL=your_supabase_url
# VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# ⚠️ SECURITY: NEVER put email API keys in VITE_* variables.
# Anything prefixed VITE_ is bundled into browser code and is public.
# Resend credentials must only ever be used server-side
# (Cloudflare Worker / Pages Function), never in the frontend.

